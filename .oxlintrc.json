{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "max-depth": ["error", 2],
    "no-console": "error",
    "id-length": [
      "error",
      {
        "min": 2,
        "exceptions": ["_", "T"]
      }
    ],
    "typescript/prefer-for-of": "error",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_links"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/commands/**/*.ts", "src/core/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/providers/testrail/http.js",
                  "**/providers/testrail/paging.js",
                  "**/providers/testrail/errors.js",
                  "**/providers/testrail/index.js",
                  "**/providers/testrail/services/*"
                ],
                "allowTypeImports": true,
                "message": "Commands and core reach TestRail through provider() from providers/index.js; only types, ids and lookups are imported directly."
              }
            ]
          }
        ]
      }
    }
  ]
}
